# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key is ONLY used in server-side API routes (never exposed to the browser).
# Needed for admin actions like locking gameweeks and recalculating points.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
